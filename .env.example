# d8a-de-workbench: copy to .env. The defaults work on a laptop.
POSTGRES_USER=d8a
POSTGRES_PASSWORD=d8a
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# app context: events per second written by the simulator; set APP_EVENTS_KAFKA=redpanda:29092 once the redpanda profile is up
APP_EVENTS_RATE=20
APP_EVENTS_KAFKA=

# finance context: when the end-of-day files drop (container clock, UTC) and how many past days to drop at start
EOD_AT=02:00
EOD_BACKFILL=7

# marketing context
SAAS_API_PORT=8080
SAAS_API_TOKEN=d8a-test-token

# operations context: fleet size, past days written at start; set TELEMETRY_S3=http://minio:9000 once the minio profile is up
TELEMETRY_VEHICLES=400
TELEMETRY_BACKFILL_DAYS=1
TELEMETRY_S3=
MINIO_ROOT_USER=d8a
MINIO_ROOT_PASSWORD=d8a-lake-password

AIRFLOW_PORT=8081
